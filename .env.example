MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=detective_game
SESSION_SECRET=<generate with: openssl rand -base64 32>
# Required to register the first account, which becomes the admin.
ENVIRONMENT_KEY=<generate with: openssl rand -base64 32>
# Read-write token of a *public* Vercel Blob store (Storage tab -> your Blob store -> .env.local,
# or `vercel env pull`). Story images and videos are uploaded there.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<store-id>_<secret>

# Language models for witness interrogation and report grading (src/lib/llm).
# LLM_PROVIDER applies to both; LLM_WITNESS_PROVIDER / LLM_GRADER_PROVIDER override it per purpose.
LLM_PROVIDER=anthropic
LLM_WITNESS_MODEL=claude-haiku-5-5
LLM_GRADER_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=sk-ant-<your-key>
